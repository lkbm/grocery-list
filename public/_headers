# Applied by Workers Static Assets to every file served from dist/. These responses never reach
# the worker (assets are matched first), so headers set in main.tsx wouldn't apply to them.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
